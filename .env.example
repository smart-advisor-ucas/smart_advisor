# ─────────────────────────────────────────────────────────────────────
# Smart Advisor — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file to Git!
#
# Usage:
#   cp .env.example .env
#   # Then edit .env with your real keys
# ─────────────────────────────────────────────────────────────────────


# ── LLM Provider (pick one) ───────────────────────────────────────────
# OpenAI (recommended for prototyping)
OPENAI_API_KEY=sk-...

# Anthropic Claude (alternative)
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini (alternative)
# GOOGLE_API_KEY=...


# ── Speech-to-Text (optional, if using API-based STT) ─────────────────
# Deepgram
# DEEPGRAM_API_KEY=...

# OpenAI Whisper API (uses OPENAI_API_KEY above)


# ── Text-to-Speech (optional, if using API-based TTS) ─────────────────
# ElevenLabs
# ELEVENLABS_API_KEY=...


# ── Observability (recommended) ───────────────────────────────────────
# Langfuse Cloud
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com


# ── Application Settings ──────────────────────────────────────────────
# Path to the ChromaDB persistent storage directory
CHROMA_DB_PATH=./chroma_db

# Path to processed knowledge base JSON files
KNOWLEDGE_BASE_PATH=./data/processed

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Streamlit/Gradio server settings
APP_HOST=0.0.0.0
APP_PORT=8501


# ── RAG Pipeline Settings ─────────────────────────────────────────────
# Number of chunks to retrieve per query
TOP_K=5

# Minimum similarity threshold (0.0 to 1.0) — below this, fallback triggers
SIMILARITY_THRESHOLD=0.65

# Embedding model name (from HuggingFace)
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# LLM model name (e.g., gpt-4o-mini, claude-3-5-haiku, gemini-1.5-flash)
LLM_MODEL=gpt-4o-mini

# Max tokens for LLM response
MAX_TOKENS=512


# ── Voice pillar (src/voice/) ─────────────────────────────────────────
# Loaded automatically at import time by src/voice/config.py (via
# python-dotenv, if installed — see requirements-voice.txt). Everything
# below is optional: unset, the voice layer runs in mock mode, needing
# none of it.

# Backend mode: mock (default, no deps/keys needed) | real
VOICE_BACKEND=mock

# Whisper model used by real-mode STT (transformers model id). Defaults to
# large-v3-turbo (~1.6GB, fast on CPU); set to openai/whisper-large-v3 for
# max accuracy if you have a GPU.
WHISPER_MODEL_ID=openai/whisper-large-v3-turbo

# TTS engine, only used when VOICE_BACKEND=real: azure | piper | auto (default)
VOICE_TTS=auto

# Azure Neural TTS — used by "azure" and "auto"
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Piper offline TTS — used by "piper" and "auto"
# Optional: path to a local ar_JO-kareem .onnx model. If unset, it's
# downloaded once from the rhasspy/piper-voices HF repo and cached.
PIPER_MODEL_PATH=
# Speaking rate multiplier; <1.0 is faster.
PIPER_LENGTH_SCALE=0.95
