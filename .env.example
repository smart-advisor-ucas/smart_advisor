# Copy to .env and fill in real values. Never commit the real .env.
# NOTE: do NOT wrap values in quotes — when this file is passed to
# `docker run --env-file`, the quotes become part of the value and break auth.

# ── LLM keys (required — the app refuses to boot without these two) ──────
OPENROUTER_API_KEY=sk-or-your-key-here
GROQ_API_KEY=gsk_your-key-here

# Optional Hugging Face token
HF_TOKEN=

# ── Advisor fallback notifications ───────────────────────────────────────
# Channel for "unknown question" notifications to the human advisor:
#   email_api — email via the Resend HTTPS API (default; the only channel
#               that works from Hugging Face Spaces — SMTP port 587 and
#               Telegram are both blocked there, HTTPS on 443 is not)
#   email     — Gmail SMTP (works locally only)
#   telegram  — Telegram bot (works locally only)
#   both      — send on both SMTP and Telegram
NOTIFY_CHANNEL=email_api

# Recipient for both email channels.
ADVISOR_EMAIL=advisor@example.com

# email_api channel — needed when NOTIFY_CHANNEL is email_api.
# Free-tier Resend without a verified domain: use onboarding@resend.dev as
# RESEND_FROM, and ADVISOR_EMAIL must be the address the Resend account was
# registered with. Verify your own domain in Resend to lift both limits.
RESEND_API_KEY=re_your-resend-key
RESEND_FROM=onboarding@resend.dev

# SMTP email channel — needed when NOTIFY_CHANNEL is email or both.
# SMTP_APP_PASSWORD is a Gmail App Password (Google account → Security →
# 2-Step Verification → App passwords), not the account password.
SMTP_EMAIL=sender.account@gmail.com
SMTP_APP_PASSWORD=your-gmail-app-password

# Telegram channel — needed when NOTIFY_CHANNEL is telegram or both.
TELEGRAM_BOT_TOKEN=123456:your-bot-token
TELEGRAM_CHAT_ID=123456789
# Optional Cloudflare Worker relay in front of api.telegram.org
TELEGRAM_API_BASE=https://api.telegram.org

# ── Voice (see src/voice/config.py) ──────────────────────────────────────
VOICE_BACKEND=mock
VOICE_TTS=auto
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
